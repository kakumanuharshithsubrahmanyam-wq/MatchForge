# Copy to .env and adjust for local use (do not commit .env).

POSTGRES_DB=matchforge
POSTGRES_USER=matchforge
POSTGRES_PASSWORD=change-me-in-local-env
APP_PORT=8080

# Host port for Compose Postgres is 5433 (see docker-compose.yml). Internal container port remains 5432.
# Used when running the app outside Docker (./mvnw spring-boot:run)
DB_URL=jdbc:postgresql://localhost:5433/matchforge
DB_USERNAME=matchforge
DB_PASSWORD=change-me-in-local-env