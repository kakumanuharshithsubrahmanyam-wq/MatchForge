# Copy to .env and adjust for local use (do not commit .env).

POSTGRES_DB=matchforge
POSTGRES_USER=matchforge
POSTGRES_PASSWORD=change-me-in-local-env
APP_PORT=8080

# Host port for Compose Postgres is 5433 (see docker-compose.yml). Internal container port remains 5432.
# Used when running the app outside Docker (./mvnw spring-boot:run)
DB_URL=jdbc:postgresql://localhost:5433/matchforge
DB_USERNAME=matchforge
DB_PASSWORD=change-me-in-local-env

# Phase 4 — security (required outside local dev defaults)
MATCHFORGE_JWT_SECRET=replace-with-256-bit-or-longer-random-secret
MATCHFORGE_ADMIN_USERNAME=local-admin
MATCHFORGE_ADMIN_PASSWORD=replace-with-strong-admin-passphrase

# Set true once when adopting an existing Phase 0–3 database (after backup); then run app so V2+ apply
MATCHFORGE_FLYWAY_BASELINE=false

# Docker Compose (app service) — set when using docker compose up
# MATCHFORGE_JWT_SECRET already defined above
# MATCHFORGE_ADMIN_USERNAME already defined above
# MATCHFORGE_ADMIN_PASSWORD already defined above
# For existing Postgres volume data, use MATCHFORGE_FLYWAY_BASELINE=true once

# Optional login lockout tuning (defaults: 5 attempts, 900 seconds)
# MATCHFORGE_SECURITY_MAX_FAILED_LOGIN_ATTEMPTS=5
# MATCHFORGE_SECURITY_LOGIN_LOCKOUT_SECONDS=900

# Neon (hosted PostgreSQL) — use the direct connection string for Flyway + runtime on small deployments.
# Example (replace host/user/password/db; append sslmode=require if not present):
# DB_URL=jdbc:postgresql://ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# DB_USERNAME=neondb_owner
# DB_PASSWORD=replace-from-neon-console
# SPRING_PROFILES_ACTIVE=prod
# MATCHFORGE_FLYWAY_BASELINE=false