{
  "info": {
    "name": "MatchForge API",
    "description": "REST API for MatchForge matchmaking and game sessions. Set `baseUrl` and run auth requests first. Do not store real passwords in this collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "playerAUsername", "value": "player_a_example" },
    { "key": "playerBUsername", "value": "player_b_example" },
    { "key": "playerPassword", "value": "replace-with-strong-password" },
    { "key": "adminUsername", "value": "replace-admin-username" },
    { "key": "adminPassword", "value": "replace-admin-password" },
    { "key": "playerAToken", "value": "" },
    { "key": "playerBToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "playerAId", "value": "" },
    { "key": "playerBId", "value": "" },
    { "key": "matchId", "value": "" },
    { "key": "sessionId", "value": "" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register player A",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{playerAUsername}}\",\n  \"password\": \"{{playerPassword}}\",\n  \"skillRating\": 1000\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Created', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('playerAToken', j.accessToken);",
                  "pm.collectionVariables.set('playerAId', j.playerId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register player B",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{playerBUsername}}\",\n  \"password\": \"{{playerPassword}}\",\n  \"skillRating\": 1020\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Created', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('playerBToken', j.accessToken);",
                  "pm.collectionVariables.set('playerBId', j.playerId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login player A",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{playerAUsername}}\",\n  \"password\": \"{{playerPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('playerAToken', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login administrator",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('adminToken', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Players",
      "item": [
        {
          "name": "Get own profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{playerAToken}}" }],
            "url": "{{baseUrl}}/api/v1/players/{{playerAId}}"
          }
        },
        {
          "name": "Update availability",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{playerAToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"available\": true\n}" },
            "url": "{{baseUrl}}/api/v1/players/{{playerAId}}/availability"
          }
        },
        {
          "name": "Create player (ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"ops_player\",\n  \"skillRating\": 900\n}"
            },
            "url": "{{baseUrl}}/api/v1/players"
          }
        },
        {
          "name": "List players (ADMIN)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/players"
          }
        }
      ]
    },
    {
      "name": "Matchmaking",
      "item": [
        {
          "name": "Join queue (player A)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{playerAToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"playerId\": \"{{playerAId}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/matchmaking/queue"
          }
        },
        {
          "name": "Join queue (player B — expect MATCHED)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{playerBToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"playerId\": \"{{playerBId}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/matchmaking/queue"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.matchId) pm.collectionVariables.set('matchId', j.matchId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Queue status",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{playerAToken}}" }],
            "url": "{{baseUrl}}/api/v1/matchmaking/queue/{{playerAId}}"
          }
        },
        {
          "name": "Leave queue",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{playerAToken}}" }],
            "url": "{{baseUrl}}/api/v1/matchmaking/queue/{{playerAId}}"
          }
        }
      ]
    },
    {
      "name": "Matches",
      "item": [
        {
          "name": "Get match",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{playerAToken}}" }],
            "url": "{{baseUrl}}/api/v1/matches/{{matchId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.sessionId) pm.collectionVariables.set('sessionId', j.sessionId);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Sessions",
      "item": [
        {
          "name": "Get session",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{playerAToken}}" }],
            "url": "{{baseUrl}}/api/v1/sessions/{{sessionId}}"
          }
        },
        {
          "name": "List participants",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{playerAToken}}" }],
            "url": "{{baseUrl}}/api/v1/sessions/{{sessionId}}/participants"
          }
        },
        {
          "name": "Join session (A)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{playerAToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"playerId\": \"{{playerAId}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/sessions/{{sessionId}}/join"
          }
        },
        {
          "name": "Join session (B)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{playerBToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"playerId\": \"{{playerBId}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/sessions/{{sessionId}}/join"
          }
        },
        {
          "name": "Heartbeat",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{playerAToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"playerId\": \"{{playerAId}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/sessions/{{sessionId}}/heartbeat"
          }
        },
        {
          "name": "Disconnect",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{playerAToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"playerId\": \"{{playerAId}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/sessions/{{sessionId}}/disconnect"
          }
        },
        {
          "name": "Reconnect",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{playerAToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"playerId\": \"{{playerAId}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/sessions/{{sessionId}}/reconnect"
          }
        },
        {
          "name": "Complete session (ADMIN)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/sessions/{{sessionId}}/complete"
          }
        },
        {
          "name": "Cancel session (ADMIN)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/sessions/{{sessionId}}/cancel"
          }
        }
      ]
    }
  ]
}